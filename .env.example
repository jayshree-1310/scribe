# Root environment file, read by docker-compose.prod.yml only.
# Copy to `.env` and fill in real values:  cp .env.example .env
#
# The development stack (docker-compose.yml) does not use this file — it reads
# apps/api/.env and apps/web/.env instead.

# --- Database -------------------------------------------------------------
POSTGRES_DB=scribe
POSTGRES_USER=scribe
POSTGRES_PASSWORD=

# --- API ------------------------------------------------------------------
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Browser origins allowed to call the API, comma-separated. Unset allows any
# origin, which is not what you want in production.
CORS_ORIGIN=

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# --- Google sign-in -------------------------------------------------------
# Must be the same OAuth client id on both sides: the API verifies that each
# ID token was minted for this audience.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Published port -------------------------------------------------------
# Host port for nginx, which serves the web bundle and proxies /api.
WEB_PORT=8080
