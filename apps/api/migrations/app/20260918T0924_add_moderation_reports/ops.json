  {
    "id": "table.report",
    "label": "Create table \"report\"",
    "summary": "Creates table \"report\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "moderation",
        "objectType": "table",
        "name": "report"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"report\" does not exist",
        "sql": "SELECT (to_regclass($1)) IS NULL AS \"result\"",
        "params": [
          "\"moderation\".\"report\""
        ]
      }
    ],
    "execute": [
      {
        "description": "create table \"report\"",
        "sql": "CREATE TABLE \"moderation\".\"report\" (\n  \"action\" text,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"details\" text,\n  \"id\" text NOT NULL,\n  \"note\" text,\n  \"reason\" text NOT NULL,\n  \"reporterId\" text NOT NULL,\n  \"resolvedAt\" timestamptz,\n  \"resolvedById\" text,\n  \"status\" text DEFAULT 'OPEN' NOT NULL,\n  \"targetId\" text NOT NULL,\n  \"targetType\" text NOT NULL,\n  \"updatedAt\" timestamptz DEFAULT (now()) NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"report_action_check_5f2de721\" CHECK (\"action\" IN ('DISMISS', 'HIDE', 'SUSPEND')),\n  CONSTRAINT \"report_reason_check_735e3aeb\" CHECK (\"reason\" IN ('SPAM', 'HARASSMENT', 'HATE', 'SEXUAL', 'VIOLENCE', 'SPOILER', 'OTHER')),\n  CONSTRAINT \"report_status_check_2a206a64\" CHECK (\"status\" IN ('OPEN', 'RESOLVED')),\n  CONSTRAINT \"report_targetType_check_2c6acd2f\" CHECK (\"targetType\" IN ('COMMENT', 'CLUB_DISCUSSION', 'CHANNEL_POST'))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"report\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"moderation\".\"report\""
        ]
      }
    ]
  },
