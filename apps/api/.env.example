# Copy this file to `.env` and replace the placeholders with real values.

# Connection string for PostgreSQL. Requires PostgreSQL >= 15.
# The local Docker stack (see docker-compose.yml at the repo root) serves:
DATABASE_URL="postgresql://scribe:scribe_dev_password@localhost:1301/scribe"

# Redis, used for auth rate limiting and refresh-token state. The local Docker
# stack serves it on 1304.
REDIS_URL="redis://localhost:1304"

# Port the API listens on. Defaults to 3000; the local stack uses 1303.
PORT=1303

# Log verbosity: trace | debug | info | warn | error | fatal | silent.
# Defaults to `debug` outside production, `info` in production.
# LOG_LEVEL=debug

# Comma-separated list of browser origins allowed to call the API.
# Leave unset to allow any origin (fine for local development).
# CORS_ORIGIN=http://localhost:1302

# Signing secrets for access and refresh tokens. `lib/jwt.ts` throws at
# startup if either is missing, so there is no insecure default to inherit.
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Salts the digest that identifies a signed-out reader for one day, so author
# analytics can count them without storing anything that tracks them across
# days. Optional: unset, `services/analytics.ts` derives one from
# JWT_ACCESS_SECRET through a purpose string, which is safe but ties two
# unrelated things to one secret. Generate with: openssl rand -base64 32
# ANALYTICS_SALT=""

# Local development only: honour X-Scribe-User-Id so the web app can act as a
# reader without signing in. Never set this outside local development -- it
# lets any caller impersonate any user.
ALLOW_DEV_USER_HEADER=true

# Number of reverse proxies in front of the API (`1` behind nginx, as in
# docker-compose.prod.yml). Leave unset locally: trusting X-Forwarded-For with
# no real proxy in front lets clients forge their IP.
# TRUST_PROXY=1

# Google sign-in: the OAuth 2.0 *Web application* client id. Must match the
# web app's VITE_GOOGLE_CLIENT_ID -- the API verifies that each ID token was
# minted for this audience.
GOOGLE_CLIENT_ID=""

# Where uploaded files (avatars today; covers and chapter media later) are
# written. Relative paths resolve against the API's working directory. The
# directory is created on first upload and served at /uploads.
# UPLOAD_DIR=uploads

# --- Email --------------------------------------------------------------
#
# Password reset and email verification send links into the web app. Both work
# out of the box with no credentials: the default transport prints the message
# (link included) to the API log, which in local development is the inbox.

# `log` (default) prints instead of sending. See lib/mailer.ts for the one
# clearly marked place a real provider is dropped in.
# MAIL_TRANSPORT=log

# Where links in those emails point -- the *web app's* origin, not the API's.
# Derived from the request would mean trusting a Host header an attacker
# controls, which is exactly how a reset link ends up on someone else's domain.
# WEB_APP_URL=http://localhost:1302

# Absolute origin to prefix upload URLs with, for deployments where the web app
# and the API are on different hosts. Unset -- the dev proxy case -- yields
# root-relative URLs, which work wherever the app is served from.
# PUBLIC_UPLOAD_BASE_URL=https://api.example.com

# --- AI (docs/AI-BACKLOG.md) ------------------------------------------------
#
# Every value below has a default that describes the free local stack, so AI
# needs no configuration to work locally -- but it does need a model server
# running. Nothing here is read at boot: with no server the app starts
# normally and only the AI routes answer 503.
#
#   docker compose --profile ai up -d ollama
#   docker compose exec ollama ollama pull llama3.2:3b

# `ollama` (default, free, no key, local only), `openai` (any host speaking the
# OpenAI chat-completions format -- Groq, OpenRouter, Together -- and the only
# option for a deployment with no model server of its own), or `anthropic`.
#
# For `openai`, set AI_BASE_URL to the provider's /v1 root and AI_API_KEY to
# its key, e.g. https://api.groq.com/openai/v1 with llama-3.3-70b-versatile.
# AI_PROVIDER=ollama

# Where the model server is. Compose overrides this for the api container --
# inside the network it is http://ollama:11434, from the host localhost.
# Inside Docker the API reaches the Ollama container by service name, so the
# `localhost` default only works when the API runs on the host:
#   AI_BASE_URL=http://ollama:11434          # api in Compose -> local Ollama
#   AI_BASE_URL=http://localhost:11434       # api on the host -> local Ollama
#   AI_BASE_URL=https://api.groq.com/openai/v1   # hosted, with AI_PROVIDER=openai
# AI_BASE_URL=http://ollama:11434

# Only for hosted providers. Never expose this to the browser: the web app
# talks to /api/ai, which talks to the provider.
# AI_API_KEY=

# AI_MODEL=llama3.2:3b
# Cheaper/faster model for bulk work (extraction, classification, titles).
# Defaults to AI_MODEL so a single-model setup never calls something unpulled.
# AI_FAST_MODEL=

# AI_MAX_TOKENS=1024

# Generous because the default provider runs on this machine's CPU: a 7B model
# writing a few hundred words takes tens of seconds.
# AI_TIMEOUT_MS=120000

# Retries after the first attempt, for transient failures only (unreachable,
# busy, timed out). A model that answered badly is never retried.
# AI_MAX_RETRIES=1

# Whether a structured call sends its JSON schema to the provider. On unless
# explicitly denied (off/false/0/no). Turn it off only for a provider that
# rejects `response_format` outright: the prompts still ask for JSON and the
# replies are still validated, so features degrade rather than break.
# AI_STRUCTURED_OUTPUT=on

# Per-user token ceiling over a rolling day, checked before a call and charged
# after it -- so a caller just under the ceiling can cross it by one request's
# worth. Enforced on /api/ai/chat today; Task AI 18 extends it to every
# feature and persists the counts. 0 disables the check.
# AI_DAILY_TOKEN_BUDGET=200000

# --- Uploaded files -------------------------------------------------------
# Unset, uploads go to the local filesystem under UPLOAD_DIR, which needs no
# credentials and is what development wants. That directory is not durable on a
# host with no persistent disk: a free Render instance wipes it on every deploy
# and every spin-down, so covers and avatars stored there disappear within
# minutes of the instance going idle.
#
# Setting S3_BUCKET switches to any S3-compatible object store. Cloudflare R2 is
# the cheapest way in (free tier, no egress charges):
#
#   S3_BUCKET=scribe-media
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_PUBLIC_BASE_URL=https://media.example.com
#
# S3_PUBLIC_BASE_URL is the *read* origin — an R2 custom domain or the bucket's
# public URL — and is required alongside S3_BUCKET: the endpoint above is for
# writing, and rows need an address a browser can fetch. The API refuses to
# start if the bucket is set without it.
#
# Objects are served through bucket configuration (an R2 public bucket or
# custom domain, an S3 bucket policy) rather than per-object ACLs, which R2
# does not implement.
# S3_BUCKET=
# S3_ENDPOINT=
# S3_PUBLIC_BASE_URL=
# Most S3-compatible stores ignore the region but require one; AWS needs the
# real one. Defaults to "auto".
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
