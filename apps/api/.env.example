# Copy this file to `.env` and replace the placeholders with real values.

# Connection string for PostgreSQL. Requires PostgreSQL >= 15.
# The local Docker stack (see docker-compose.yml at the repo root) serves:
DATABASE_URL="postgresql://scribe:scribe_dev_password@localhost:1301/scribe"

# Redis, used for auth rate limiting and refresh-token state. The local Docker
# stack serves it on 1304.
REDIS_URL="redis://localhost:1304"

# Port the API listens on. Defaults to 3000; the local stack uses 1303.
PORT=1303

# Log verbosity: trace | debug | info | warn | error | fatal | silent.
# Defaults to `debug` outside production, `info` in production.
# LOG_LEVEL=debug

# Comma-separated list of browser origins allowed to call the API.
# Leave unset to allow any origin (fine for local development).
# CORS_ORIGIN=http://localhost:1302

# Signing secrets for access and refresh tokens. `lib/jwt.ts` throws at
# startup if either is missing, so there is no insecure default to inherit.
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Local development only: honour X-Scribe-User-Id so the web app can act as a
# reader without signing in. Never set this outside local development -- it
# lets any caller impersonate any user.
ALLOW_DEV_USER_HEADER=true

# Number of reverse proxies in front of the API (`1` behind nginx, as in
# docker-compose.prod.yml). Leave unset locally: trusting X-Forwarded-For with
# no real proxy in front lets clients forge their IP.
# TRUST_PROXY=1

# Google sign-in: the OAuth 2.0 *Web application* client id. Must match the
# web app's VITE_GOOGLE_CLIENT_ID -- the API verifies that each ID token was
# minted for this audience.
GOOGLE_CLIENT_ID=""

# Where uploaded files (avatars today; covers and chapter media later) are
# written. Relative paths resolve against the API's working directory. The
# directory is created on first upload and served at /uploads.
# UPLOAD_DIR=uploads

# Absolute origin to prefix upload URLs with, for deployments where the web app
# and the API are on different hosts. Unset -- the dev proxy case -- yields
# root-relative URLs, which work wherever the app is served from.
# PUBLIC_UPLOAD_BASE_URL=https://api.example.com
