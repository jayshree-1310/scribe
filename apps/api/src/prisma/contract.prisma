 // use prisma-next

enum MultimediaType {
  @@type("pg/text@1")

  IMAGE
  AUDIO
  VIDEO
  LINK
}

/// Where a work came from. Scribe has one work entity, `content.Story`;
/// this is what separates a member's own serialised writing from an imported
/// catalogue edition, which is read-only and has no chapters. See
/// `docs/content-model.md`.
enum ContentSource {
  @@type("pg/text@1")

  SCRIBE
  CATALOGUE
}

enum ClubRole {
  @@type("pg/text@1")

  OWNER
  ADMIN
  MEMBER
}

enum ReadingStatus {
  @@type("pg/text@1")

  WANT_TO_READ
  READING
  FINISHED
}

/// What happened, and therefore how a notification reads and where it links.
///
/// A closed set the database enforces, unlike `gamification.UserBadge.code`,
/// which is a deliberately unconstrained key into a catalogue that grows. The
/// difference is who owns the list: a badge is one row in an array anybody can
/// extend, while each of these six names a fan-out query in
/// `services/notifications.ts` that knows the audience for it. A seventh is a
/// migration *and* a resolver, and requiring both is what keeps the column
/// from holding a value nothing can render.
enum NotificationType {
  @@type("pg/text@1")

  // A new post in a channel the recipient subscribes to.
  CHANNEL_POST
  // A reply to a story comment or a club thread the recipient wrote.
  COMMENT_REPLY
  /// A top-level comment on a story the recipient wrote. Distinct from
  /// `COMMENT_REPLY`, which answers one comment rather than the work: an
  /// author wants to hear that somebody said something about their story, and
  /// a reader who muted replies to themselves has not asked to stop hearing
  /// about their own stories. A reply produces only `COMMENT_REPLY`, so the
  /// two never both fire for one comment.
  STORY_COMMENT
  // A new thread in a club the recipient belongs to.
  CLUB_DISCUSSION
  // A story newly listed by an author the recipient follows.
  NEW_STORY
  // A badge the recipient earned. The one type with no actor.
  BADGE_EARNED
  /// A reader or author level the recipient crossed. Like `BADGE_EARNED` it
  /// has no actor -- nobody did it to them -- and unlike it, it is derived
  /// rather than awarded, so `auth.User.announcedReaderLevel` is what keeps it
  /// from firing on every evaluation. See `announceLevels`.
  LEVEL_UP
  /// The recipient's own comment, club thread or channel post was hidden by a
  /// moderator. The one type that is bad news, and the reason moderation stops
  /// being silent: until this existed a hidden post simply vanished and an
  /// edit of it 404ed with no explanation offered anywhere.
  CONTENT_HIDDEN
  /// A report the recipient filed was acted on or dismissed. Addressed to the
  /// reporter rather than to the author, which is what makes it a different
  /// type from `CONTENT_HIDDEN` and not a second recipient of it.
  REPORT_RESOLVED
}

/// Which of the three kinds of user-written text a row is about.
///
/// One vocabulary, deliberately shared by two columns in two namespaces:
/// `moderation.Report.targetType` says what was reported, and
/// `notifications.Notification.sourceType` says what a notification quoted.
/// They have to agree, because hiding a reported comment is what sweeps the
/// notifications that copied it -- two spellings of the same three values
/// would mean a sweep that silently matched nothing.
///
/// A reader is not on the list. Every report points at something somebody
/// wrote, and suspending its author is one of the things a moderator may do
/// about it -- see `services/moderation.ts` for why that is an action rather
/// than a fourth target.
enum ReportTarget {
  @@type("pg/text@1")

  COMMENT
  CLUB_DISCUSSION
  CHANNEL_POST
}

/// Why a reader says something should not be there.
///
/// A closed set rather than free text, because the queue is read by somebody
/// triaging dozens of rows and "what kind of problem is this?" has to be
/// sortable. `OTHER` carries `Report.details`, which is where the free text
/// that would otherwise be here lives.
enum ReportReason {
  @@type("pg/text@1")

  SPAM
  HARASSMENT
  HATE
  SEXUAL
  VIOLENCE
  SPOILER
  OTHER
}

/// Whether a report is still waiting for somebody.
///
/// Two values, not four: *what was done* is `Report.action`, which is a
/// separate question with a separate answer. Folding them into one column
/// would mean `DISMISSED` and `HIDDEN` were both "not open" and nothing could
/// ask the first question without enumerating the second.
enum ReportStatus {
  @@type("pg/text@1")

  OPEN
  RESOLVED
}

/// What the automated check concluded about one piece of content.
///
/// `UNCHECKED` is not a fourth verdict but the absence of one: the model could
/// not be reached or answered unusably, and the content was left exactly as it
/// was posted. It is a value rather than a missing row so that "what has never
/// been looked at?" is a query -- see `services/ai/moderation.ts`.
enum ModerationOutcome {
  @@type("pg/text@1")

  ALLOW
  REVIEW
  REJECT
  UNCHECKED
}

/// What a moderator did about it. Null while the report is open.
///
/// `DISMISS` is not "do nothing": it restores content an earlier call hid and
/// lifts a suspension that same report imposed, which is what makes a wrong
/// call reversible. See `services/moderation.ts`.
enum ReportAction {
  @@type("pg/text@1")

  DISMISS
  HIDE
  SUSPEND
}

/// How long a work a reader wants to be handed.
///
/// Four names rather than a word count, because the reader is answering "what
/// do you feel like?" and not "how many words?". Turning a story's length into
/// one of these happens in exactly one place -- `LENGTH_BUCKETS` in
/// `services/recommendations.ts` -- so the boundaries can move without this
/// vocabulary changing.
///
/// `ANY` is a real answer and the default. It says "do not rank me on length",
/// which is a different thing from never having been asked; the absence of a
/// `UserPreference` row is what says that.
enum ContentLength {
  @@type("pg/text@1")

  SHORT
  MEDIUM
  LONG
  ANY
}

namespace auth {
  model User {
    id        String   @id @default(uuid())
    username  String   @unique
    email     String   @unique

    /// Null for accounts that only ever signed in with Google, which have no
    /// password to hash. Password login must therefore treat a null hash as
    /// "this account cannot be signed into that way".
    passwordHash String?

    /// Google's `sub` claim: stable for the life of the account, unlike the
    /// email, which can be reassigned. This is the anchor for matching a
    /// returning Google user.
    googleId      String? @unique
    /// True only when the identity provider asserted it. Password signups have
    /// no verification flow yet, so they stay false.
    emailVerified Boolean @default(false)

    /// Supplied by Google (`name` / `picture`); absent for password signups,
    /// where the UI falls back to the username.
    displayName String?
    avatarUrl   String?

    /// Free text the profile page renders. Null and empty mean the same thing
    /// to the UI, so the API normalises a cleared bio to null.
    bio         String?

    isAuthor      Boolean @default(false)

    /// Platform administrator: may create and edit writing challenges, and is
    /// the flag every later privileged surface reads rather than inventing a
    /// second one.
    ///
    /// A boolean rather than a role enum because there is exactly one
    /// privileged set of actions today -- two enum values that did the same
    /// thing would be a distinction nothing enforces. Granted by
    /// `scripts/grant-admin.ts`; there is no endpoint that sets it, so no
    /// request can escalate itself.
    isAdmin       Boolean @default(false)

    /// When a moderator suspended this account, or null for an account in
    /// good standing. A timestamp rather than a boolean for the reason
    /// `Notification.readAt` is one: it answers "is it?" and "since when?"
    /// with one column instead of two that can disagree.
    ///
    /// Suspension stops an account *writing* -- comments, club threads,
    /// channel posts, reports -- and nothing else; a suspended reader still
    /// reads. `assertNotSuspended` in `services/roles.ts` is the only place
    /// this is read, and the list of write seams that call it is in the
    /// header of `services/moderation.ts`.
    suspendedAt   DateTime?

    readingStreak Int     @default(0)

    /// The reading event `readingStreak` was last advanced for.
    ///
    /// The streak cannot be recomputed from `ReadingHistory`, which keeps only
    /// the latest position per story and so forgets every day but the last --
    /// so the rule needs the previous day stored beside the count it advances.
    /// Null means the reader has no recorded reading yet.
    ///
    /// Deliberately not `ReadingHistory.lastReadAt`'s maximum: that moves when
    /// a reader revisits an old story, which is the same day-boundary question
    /// and a different row.
    streakLastReadAt DateTime?

    /// The longest run `readingStreak` has ever reached.
    ///
    /// `readingStreak` is the *current* run and resets to 1 on a missed day,
    /// which made "read 30 days in a row" earnable only while the run was
    /// still alive: a reader who managed forty days last year and is on three
    /// today could not hold the badge they had plainly earned. The metric the
    /// badges read is this one. Advanced in the same compare-and-set that
    /// advances the streak, so it can never lag behind it.
    longestStreak Int @default(0)

    authorLevel   Int     @default(1)
    readerLevel   Int     @default(1)

    /// The levels the reader has actually been *told* about.
    ///
    /// Levels are derived on every evaluation rather than awarded, so unlike a
    /// badge there is no inserted row to hang a notification on -- nothing
    /// anywhere knew that a level had just changed as opposed to merely being
    /// high. These two columns are that knowledge: when a derived level is
    /// above the announced one, the difference is the announcement owed, and
    /// writing it back is what stops it being made twice.
    ///
    /// Defaulted to 1, the level everybody starts at, so an existing account
    /// is not told it reached a level it has held for months. See
    /// `announceLevels` in `services/gamification.ts`.
    announcedReaderLevel Int @default(1)
    announcedAuthorLevel Int @default(1)

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now())

    comments         engagement.Comment[]
    commentLikes     engagement.CommentLike[]
    chapterLikes     engagement.ChapterLike[]
    ratings          engagement.Rating[]
    readingHistory   engagement.ReadingHistory[]
    storyViews       engagement.StoryView[]
    chapterReads     engagement.ChapterRead[]
    /// Rows where this account is the one being followed.
    followers        engagement.Follow[] @relation("Followers")
    /// Rows where this account is the one doing the following.
    following        engagement.Follow[] @relation("Following")
    badges           gamification.UserBadge[]
    challengeEntries challenges.ChallengeEntry[]
    hostedChallenges challenges.WritingChallenge[]
    createdClubs     clubs.BookClub[]
    clubMemberships  clubs.ClubMembership[]
    clubDiscussions  clubs.ClubDiscussion[]
    channels         channels.BroadcastChannel[]
    subscriptions    channels.ChannelSubscriber[]
    /// Notifications addressed to this account.
    notifications    notifications.Notification[] @relation("NotificationRecipient")
    /// Notifications this account caused somebody else to receive.
    notified         notifications.Notification[] @relation("NotificationActor")
    /// Reports this account filed.
    reportsFiled     moderation.Report[] @relation("ReportReporter")
    /// Reports this account resolved, as a moderator.
    reportsResolved  moderation.Report[] @relation("ReportResolver")
    /// Absent until the reader answers something. See `UserPreference`.
    preference       UserPreference?
    genrePreferences GenrePreference[]
    notificationMutes NotificationMute[]
    /// Ask This Book conversations this reader started; see `ai.Conversation`.
    conversations    ai.Conversation[]
  }

  /// One reader's settings: what they want recommended, and what they would
  /// rather not be told about.
  ///
  /// **A row per account, not columns on `User`.** `User` is who somebody is;
  /// this is what they answered. The distinction pays at exactly one moment --
  /// a row that does not exist means "never asked", which no default on a
  /// column can express, and which is the whole of how the web app knows to
  /// show onboarding rather than skip it.
  ///
  /// **One table, two customers.** `services/recommendations.ts` ranks on the
  /// genres and the length; `services/notifications.ts` filters its fan-out on
  /// the mutes. Task 14 left notification preferences unbuilt on the argument
  /// that they wanted this table rather than a second settings model beside
  /// it, and that is why this is not called `RecommendationPreference`. The
  /// third customer follows the same rule: a preference is a row here.
  ///
  /// Every read tolerates the row's absence and answers with the defaults in
  /// `services/preferences.ts`, so nothing has to create one to read one.
  model UserPreference {
    /// The account, and the key: there is one row per reader, so a surrogate
    /// id would only be a second way to address the same thing.
    userId String @id

    contentLength ContentLength @default(ANY)

    /// When onboarding was finished, or null while it has not been.
    ///
    /// A timestamp rather than a boolean, the way `Notification.readAt` and
    /// `User.suspendedAt` are: one column answering "is it?" and "when?"
    /// cannot disagree with itself. The web app gates the flow on this rather
    /// than on local state, so a refresh halfway through resumes instead of
    /// skipping to the feed.
    onboardingCompletedAt DateTime?

    /// The furthest step of onboarding the reader has reached, zero-based.
    ///
    /// Saving per step is what makes a refresh resume, but the row alone could
    /// not say *where* to resume: a reader who quit at the author step had
    /// genres saved and was still put back at step one, to walk forward
    /// through answers they had already given. This is the number that stops
    /// that. It only ever moves forward -- going back a step to change an
    /// answer is not losing progress -- so the write is a `GREATEST`.
    onboardingStep Int @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now())

    user auth.User
      @relation(fields: [userId], references: [id])
  }

  /// A genre the reader said they like.
  ///
  /// The junction `content.StoryGenre` already is on the other side of the
  /// same question, and deliberately the same shape: a composite key and no
  /// surrogate id, so saying "Fantasy" twice is a no-op rather than a second
  /// row, and replacing the whole set is a delete and an insert with nothing
  /// to reconcile.
  ///
  /// Hung off `auth.User` rather than off `UserPreference`, like every other
  /// per-reader table in this contract: a reader who picked genres and never
  /// finished onboarding has rows here and may have no settings row at all,
  /// and neither fact should depend on the other.
  model GenrePreference {
    userId    String
    genreId   String
    createdAt DateTime @default(now())

    user  auth.User
      @relation(fields: [userId], references: [id])
    genre content.Genre
      @relation(fields: [genreId], references: [id])

    @@id([userId, genreId])
    /// Everybody who likes one genre -- how author suggestions are found.
    @@index([genreId])
  }

  /// One notification type one reader does not want.
  ///
  /// Rows for what is *off*, rather than a column per type that is on.
  /// `NotificationType` grows a value whenever a sixth thing becomes worth
  /// telling somebody about, and a column per type would make each of those a
  /// migration. An account with no rows here hears about everything, which is
  /// what an account that has never opened settings should do.
  model NotificationMute {
    userId    String
    type      NotificationType
    createdAt DateTime @default(now())

    user auth.User
      @relation(fields: [userId], references: [id])

    @@id([userId, type])
  }
}

namespace content {
  model Story {
    id              String   @id @default(uuid())
    authorId        String
    title           String

    /// Stable, URL-safe identity. Every reader-facing route addresses a story
    /// by this rather than by id, so it is generated once from the title and
    /// then survives a rename.
    slug            String   @unique

    source          ContentSource @default(SCRIBE)

    /// When the story became visible on Scribe. Null means draft: only the
    /// author can see it.
    ///
    /// Deliberately *not* `publishedAt` below, which is the edition's own
    /// publication date -- a catalogue import carries 1937 there while
    /// becoming visible on Scribe the day it was imported, and a draft would
    /// otherwise be indistinguishable from an import with an unknown date.
    listedAt        DateTime?

    coverUrl        String?
    description     String?
    createdAt       DateTime @default(now())
    updatedAt       DateTime @default(now())
    isCompleted     Boolean  @default(false)
    viewCount       Int      @default(0)
    likeCount       Int      @default(0)

    /// Denormalised from `engagement.Rating`, recomputed inside the same
    /// transaction as every rating write so the two cannot drift. They exist
    /// because `sort=rating` orders in SQL over the story table -- an average
    /// gathered per page could not be sorted on -- and because a seeded
    /// catalogue edition carries an average with no `Rating` rows behind it.
    ratingAverage   Decimal?
    ratingCount     Int      @default(0)
    kidsAppropriate Boolean  @default(false)

    // Publication metadata. Optional: works serialised on Scribe have no
    // publisher or ISBN, while catalogued editions do.
    isbn            String?  @unique
    publisher       String?
    publishedAt     DateTime?
    pageCount       Int?

    author           auth.User
      @relation(fields: [authorId], references: [id])
    chapters         Chapter[]
    genres           StoryGenre[]
    comments         engagement.Comment[]
    ratings          engagement.Rating[]
    readingHistory   engagement.ReadingHistory[]
    views            engagement.StoryView[]
    reads            engagement.ChapterRead[]
    challengeEntries challenges.ChallengeEntry[]
    /// Clubs currently reading this story together.
    clubReads        clubs.BookClub[]
    /// Embedded passages of this story's chapters; see `ai.ChapterChunk`.
    embeddingChunks  ai.ChapterChunk[]
    /// Readers' Ask This Book conversations about this story.
    conversations    ai.Conversation[]
    /// The author's story bible; see `ai.StoryFact`.
    storyFacts           ai.StoryFact[]
    chapterExtractions   ai.ChapterExtraction[]
    continuityChecks     ai.ContinuityCheck[]
    continuityFindings   ai.ContinuityFinding[]
    continuityDismissals ai.ContinuityDismissal[]
  }

  model Chapter {
    id            String   @id @default(uuid())
    storyId       String
    title         String
    content       String
    chapterNumber Int

    /// Denormalised so the chapter list can show a length without loading
    /// every body. Written by the authoring endpoints on every content edit.
    wordCount     Int      @default(0)
    createdAt     DateTime @default(now())
    updatedAt     DateTime @default(now())
    publishedAt   DateTime?

    story          Story
      @relation(fields: [storyId], references: [id])
    multimedia     Multimedia[]
    comments       engagement.Comment[]
    likes          engagement.ChapterLike[]
    readingHistory engagement.ReadingHistory[]
    reads          engagement.ChapterRead[]
    /// The generated recap of this chapter, if one has ever been asked for.
    /// Optional because it is derived and lazy: most chapters never have one.
    summary        ai.ChapterSummary?
    /// This chapter's embedded passages; see `ai.ChapterChunk`.
    embeddingChunks ai.ChapterChunk[]
    /// Places an Ask This Book answer cited this chapter.
    conversationCitations ai.ConversationCitation[]
    /// Story-bible facts this chapter is the evidence for.
    storyFacts            ai.StoryFact[]
    /// When this chapter's facts were last extracted, and from what.
    extraction            ai.ChapterExtraction?
    /// When this chapter was last checked for continuity, and from what.
    continuityCheck       ai.ContinuityCheck?
    /// Continuity findings raised *about* this chapter...
    continuityFindings    ai.ContinuityFinding[] @relation("ContinuityFindingChapter")
    /// ...and findings whose contradicting evidence comes *from* it.
    continuityEvidence    ai.ContinuityFinding[] @relation("ContinuityFindingEvidence")

    @@unique([storyId, chapterNumber])
  }

  model Multimedia {
    id           String          @id @default(uuid())
    chapterId    String
    type         MultimediaType
    url          String
    displayOrder Int             @default(0)
    createdAt    DateTime        @default(now())

    chapter Chapter
      @relation(fields: [chapterId], references: [id])
  }

  model Genre {
    id        String   @id @default(uuid())
    name      String   @unique
    // Base hue (0-359) the UI composes cover art and chips from.
    hue       Int      @default(268)
    createdAt DateTime @default(now())

    stories     StoryGenre[]
    /// Readers who named this genre during onboarding.
    preferredBy auth.GenrePreference[]
  }

  model StoryGenre {
    storyId String
    genreId String

    story Story
      @relation(fields: [storyId], references: [id])
    genre Genre
      @relation(fields: [genreId], references: [id])

    @@id([storyId, genreId])
  }
}

namespace engagement {
  /// A reader's comment on a story, or on one chapter of it when `chapterId`
  /// is set -- the reader's comment panel is chapter-scoped, the story page's
  /// thread is not.
  ///
  /// Threads and replies share this table, told apart by `parentId`, the same
  /// way `clubs.ClubDiscussion` and for the same reason: one read path, so
  /// there is a single place to audit when moderation lands. Replies are
  /// capped at one level deep by `createComment`, which re-points a reply to a
  /// reply at its thread.
  model Comment {
    id        String   @id @default(uuid())
    userId    String
    storyId   String
    chapterId String?
    parentId  String?
    content   String

    /// When a moderator hid this, or null for a visible comment. The row
    /// stays so a wrong call is one update away from being reversed, and
    /// every public read path filters on it -- see `services/moderation.ts`
    /// for the full list.
    hiddenAt  DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now())

    user    auth.User
      @relation(fields: [userId], references: [id])
    story   content.Story
      @relation(fields: [storyId], references: [id])
    chapter content.Chapter?
      @relation(fields: [chapterId], references: [id])
    parent  Comment?
      @relation("CommentReplies", fields: [parentId], references: [id])
    replies Comment[] @relation("CommentReplies")
    likes   CommentLike[]
  }

  /// One reader's like on one comment.
  ///
  /// **The pair is the key, and there is no surrogate id.** The same shape
  /// `auth.GenrePreference` and `content.StoryGenre` use, and for the same
  /// reason: a like is a fact about a pair rather than an event with its own
  /// identity, so liking twice conflicts on the primary key instead of
  /// writing a second row nobody could tell from the first. That is what lets
  /// `likeComment` insert without reading first and still be idempotent.
  ///
  /// **There is no denormalised counter beside it.** Unlike
  /// `content.Story.ratingAverage`, nothing sorts or ranks on a comment's
  /// likes -- the only reader is the comment list, which is already paginated
  /// -- so the count is one grouped aggregate over the page's ids, exactly
  /// how `replyCount` is gathered in `services/engagement.ts`. A column would
  /// be a second copy of a number with nothing to keep it honest.
  model CommentLike {
    userId    String
    commentId String
    createdAt DateTime @default(now())

    user    auth.User
      @relation(fields: [userId], references: [id])
    comment Comment
      @relation(fields: [commentId], references: [id])

    @@id([userId, commentId])
    /// One page of comments' like counts, in one grouped aggregate.
    @@index([commentId])
  }

  /// One reader's like on one chapter.
  ///
  /// The same pair-as-key shape as `CommentLike` above, for the same reasons.
  ///
  /// **Per chapter rather than per story, because that is where the button
  /// is.** The reader's footer sits at the end of one chapter, and "I liked
  /// this" said there is about the chapter just read. `content.Story.likeCount`
  /// is a separate, seeded catalogue figure that nothing on Scribe writes; it
  /// is deliberately left alone rather than made to double as the sum of
  /// these, which would mix a real count into an imported one and could not be
  /// recomputed from rows.
  model ChapterLike {
    userId    String
    chapterId String
    createdAt DateTime @default(now())

    user    auth.User
      @relation(fields: [userId], references: [id])
    chapter content.Chapter
      @relation(fields: [chapterId], references: [id])

    @@id([userId, chapterId])
    /// One chapter's like count, which is what the reader footer draws.
    @@index([chapterId])
  }

  model Rating {
    id        String   @id @default(uuid())
    userId    String
    storyId   String
    rating    Decimal
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now())

    user  auth.User
      @relation(fields: [userId], references: [id])
    story content.Story
      @relation(fields: [storyId], references: [id])

    @@unique([userId, storyId])
  }

  /// One row per reader per story: where they are now, not where they have
  /// been. The unique pair below is what makes "continue reading" one row per
  /// story without a dedupe pass, and what the progress upsert conflicts on.
  model ReadingHistory {
    id         String   @id @default(uuid())
    userId     String
    storyId    String
    chapterId  String?

    /// Character offset into `chapter.content`, not a pixel scroll position:
    /// the reader's font size and width are user preferences, so a pixel
    /// offset restores to the wrong paragraph as soon as either changes.
    offset     Int      @default(0)

    /// Whole-story completion, 0-100. Derived server-side from `offset` and
    /// the word counts of the chapters the reader can see -- a client cannot
    /// know the story's total length from the one chapter it has loaded.
    progress   Int      @default(0)

    lastReadAt DateTime @default(now())
    createdAt  DateTime @default(now())
    updatedAt  DateTime @default(now())

    user    auth.User
      @relation(fields: [userId], references: [id])
    story   content.Story
      @relation(fields: [storyId], references: [id])
    chapter content.Chapter?
      @relation(fields: [chapterId], references: [id])

    @@unique([userId, storyId])
  }

  /// One reader following another.
  ///
  /// In `engagement` rather than `auth` for the same reason the rest of this
  /// namespace is: `auth` describes who somebody is, and this describes
  /// something they did. It is the same kind of row as a rating, with another
  /// reader as its object instead of a story.
  ///
  /// The pair is unique, so following twice is a no-op rather than a second
  /// row. Following *yourself* is refused by `services/users.ts`: the contract
  /// has no way to express a check constraint, so that rule lives in exactly
  /// one place and a test pins it.
  model Follow {
    id          String   @id @default(uuid())
    followerId  String
    followingId String
    createdAt   DateTime @default(now())

    follower  auth.User @relation("Following", fields: [followerId], references: [id])
    following auth.User @relation("Followers", fields: [followingId], references: [id])

    @@unique([followerId, followingId])
    // Somebody's follower list, newest first -- and the follower count.
    @@index([followingId, createdAt])
    // Who somebody follows, newest first -- and the following count.
    @@index([followerId, createdAt])
  }

  /// One reader opening one story, on one UTC day.
  ///
  /// The event log behind author analytics. `content.Story.viewCount` is the
  /// lifetime counter and is what `sort=views` orders on in SQL, exactly as
  /// `ratingAverage` is for `sort=rating`; a counter cannot answer "how many
  /// on Tuesday?", which is the only question a chart asks. So the counter
  /// stays and this records *when*.
  ///
  /// **The grain is the dedupe rule.** One row per visitor per story per day,
  /// enforced by the unique key rather than by a check in application code --
  /// a refresh, a back button and a second tab all conflict on it and insert
  /// nothing. That is why `day` is stored: a unique constraint can only be
  /// declared over columns, so the truncated day has to *be* one.
  ///
  /// `day` is text in `YYYY-MM-DD` rather than a timestamp, written by
  /// `to_char(now() AT TIME ZONE 'UTC', ...)`. A truncated `timestamptz`
  /// would take its day boundary from whatever `TimeZone` the session happens
  /// to carry, so the same second could land on two different days for two
  /// connections and dedupe against neither. Text makes the boundary explicit
  /// and sorts and ranges correctly because ISO dates do.
  model StoryView {
    id         String   @id @default(uuid())

    storyId    String

    /// Null for a signed-out reader, who is still counted -- most readers are
    /// signed out, and a view count that only saw members would be wrong by
    /// the same margin every day.
    userId     String?

    /// Who the dedupe is *per*. The reader's id when there is one, otherwise
    /// a salted digest of the address and user agent that is re-salted every
    /// day, so it identifies a visitor within a day and nobody across days.
    /// See `services/analytics.ts`.
    visitorKey String

    /// The UTC day this happened on, `YYYY-MM-DD`.
    day        String

    createdAt  DateTime @default(now())

    story content.Story
      @relation(fields: [storyId], references: [id])
    user  auth.User?
      @relation(fields: [userId], references: [id])

    // The dedupe grain, and the only uniqueness this table has.
    @@unique([storyId, visitorKey, day])
    // Every analytics read is "this story, these days".
    @@index([storyId, day])
  }

  /// One reader opening one chapter, on one UTC day. The same grain and the
  /// same rules as `StoryView` above.
  ///
  /// What it is *not*: a completed read. Whether somebody reached the end is
  /// `ReadingHistory.progress`, which is a position per reader per story and
  /// forgets every visit but the last -- it cannot be counted over a range.
  /// Opening a chapter is what the reader endpoint can actually observe, and
  /// naming the column `reads` for it is the same compromise every analytics
  /// product makes.
  ///
  /// `storyId` is carried beside `chapterId` although the chapter names its
  /// story: the author overview groups reads across a whole story and would
  /// otherwise join through `chapter` on every query for a column that can
  /// never change -- a chapter does not move between stories.
  model ChapterRead {
    id         String   @id @default(uuid())

    storyId    String
    chapterId  String
    userId     String?
    visitorKey String
    day        String
    createdAt  DateTime @default(now())

    story   content.Story
      @relation(fields: [storyId], references: [id])
    chapter content.Chapter
      @relation(fields: [chapterId], references: [id])
    user    auth.User?
      @relation(fields: [userId], references: [id])

    @@unique([chapterId, visitorKey, day])
    // The story overview's series and totals.
    @@index([storyId, day])
    // The per-chapter breakdown on one story's page.
    @@index([chapterId, day])
  }
}

namespace gamification {
  /// One badge one reader has earned, and when.
  ///
  /// There is deliberately no `Badge` table beside this one. The catalogue --
  /// what each badge is called, which metric earns it and at what threshold --
  /// is declared in `services/gamification.ts`, because every one of those
  /// fields is read by code that would have to change anyway: a threshold is
  /// only meaningful next to the SQL that computes the metric. A table would
  /// be a second copy of that declaration, synced by something, and wrong
  /// whenever the sync had not run. The same reasoning
  /// `challenges.WritingChallenge` gives for having no status column.
  ///
  /// So this table records only what the catalogue cannot: the fact of an
  /// award. `code` is the catalogue key, unenforced by any foreign key --
  /// retiring a badge therefore leaves its rows behind rather than cascading a
  /// delete through somebody's history, and the read path simply stops
  /// mentioning it.
  model UserBadge {
    id       String   @id @default(uuid())
    userId   String

    /// `BadgeDefinition.code` in `services/gamification.ts`.
    code     String

    earnedAt DateTime @default(now())

    user auth.User
      @relation(fields: [userId], references: [id])

    /// What makes awarding idempotent: the engine inserts and lets this
    /// swallow a re-award, rather than reading first and racing itself.
    @@unique([userId, code])
  }
}

namespace challenges {
  /// A timed writing brief: a prompt, a window, and the entries written to it.
  ///
  /// There is deliberately no stored status column. "Active", "upcoming" and
  /// "past" are the three positions `now()` can hold against `startAt` and
  /// `endAt`, so a column would be a second answer to the same question -- one
  /// that a missed job leaves wrong while the dates stay right.
  model WritingChallenge {
    id          String   @id @default(uuid())
    title       String

    /// Stable, URL-safe identity, derived once from the title. Every
    /// reader-facing challenge URL addresses one by this rather than by id --
    /// the same rule `content.Story.slug` and `clubs.BookClub.slug` follow.
    slug        String   @unique

    /// The brief itself, rendered as the challenge's pull quote. Separate from
    /// `description`, which is the long form underneath it.
    prompt      String
    description String?

    /// Words the host is asking for, or null for "no limit". Advisory: nothing
    /// rejects an entry for missing it, because enforcing a target would mean
    /// deciding what counts as a word.
    wordTarget  Int?

    /// The admin who set the brief. Recorded for the reason
    /// `clubs.BookClub.creatorId` is -- who started it does not change -- and
    /// it authorises nothing on its own: `auth.User.isAdmin` is what an edit
    /// is checked against.
    hostId      String

    startAt   DateTime
    endAt     DateTime
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now())

    host    auth.User
      @relation(fields: [hostId], references: [id])
    entries ChallengeEntry[]

    /// The list endpoint sorts the whole table against `now()` on this pair.
    @@index([startAt, endAt])
  }

  /// One writer's place in one challenge.
  ///
  /// Entering and submitting are two steps, which is why `storyId` is
  /// nullable: `POST /:id/enter` takes the place, `PUT /entries/:id` attaches
  /// the story once there is one to attach. That split is also what makes the
  /// challenge page's two stats mean different things -- participants are
  /// rows, entries are rows with a story on them.
  model ChallengeEntry {
    id          String   @id @default(uuid())
    challengeId String
    userId      String

    /// Null until the entrant attaches a story, and swappable until the
    /// window closes.
    storyId     String?

    /// The entrant's own note about their submission, returned only on their
    /// own entry. Stored rather than discarded because the dialog that
    /// collects it also re-opens on it.
    note        String?

    submittedAt DateTime @default(now())
    updatedAt   DateTime @default(now())

    challenge WritingChallenge
      @relation(fields: [challengeId], references: [id])
    user auth.User
      @relation(fields: [userId], references: [id])
    story content.Story?
      @relation(fields: [storyId], references: [id])

    /// One place per writer per challenge. Was `[challengeId, userId,
    /// storyId]`, which let one writer hold several rows on the leaderboard
    /// and made "already entered?" a question with no single answer.
    @@unique([challengeId, userId])
  }
}

namespace clubs {
  model BookClub {
    id          String   @id @default(uuid())
    name        String

    /// Stable, URL-safe identity, derived once from the name. Every
    /// reader-facing club URL addresses a club by this rather than by id, so
    /// it survives a rename -- the same rule `content.Story.slug` follows.
    slug        String   @unique

    description String?

    /// Who created the club. Kept alongside the `OWNER` membership rather than
    /// replaced by it: ownership transfers (`PATCH /:id/members/:userId`) and
    /// the creator is then no longer the owner, but the historical fact does
    /// not change. Authorisation reads the membership, never this column.
    creatorId   String

    /// The story the club is reading together, or null between reads.
    currentStoryId String?

    createdAt   DateTime @default(now())
    updatedAt   DateTime @default(now())

    creator     auth.User
      @relation(fields: [creatorId], references: [id])
    currentStory content.Story?
      @relation(fields: [currentStoryId], references: [id])
    memberships ClubMembership[]
    discussions ClubDiscussion[]
  }

  model ClubMembership {
    id       String   @id @default(uuid())
    clubId   String
    userId   String
    role     ClubRole @default(MEMBER)
    joinedAt DateTime @default(now())

    club BookClub
      @relation(fields: [clubId], references: [id])
    user auth.User
      @relation(fields: [userId], references: [id])

    @@unique([clubId, userId])
  }

  /// A thread in a club, or a reply to one.
  ///
  /// One table for both: a reply is a discussion whose `parentId` points at
  /// the thread it answers. Replies are one level deep by convention -- the
  /// API refuses a parent that is itself a reply -- so a thread is a flat list
  /// rather than a tree the UI would have to recurse through.
  model ClubDiscussion {
    id        String   @id @default(uuid())
    clubId    String
    userId    String
    body      String

    /// Null for a top-level thread; the thread's id for a reply.
    parentId  String?

    /// When a moderator hid this. The same column, meaning the same thing, as
    /// `engagement.Comment.hiddenAt` and `channels.ChannelPost.hiddenAt`.
    hiddenAt  DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now())

    club   BookClub
      @relation(fields: [clubId], references: [id])
    user   auth.User
      @relation(fields: [userId], references: [id])
    parent ClubDiscussion?
      @relation(fields: [parentId], references: [id])
    replies ClubDiscussion[]

    // The thread list: one club's top-level threads, newest first.
    @@index([clubId, parentId, createdAt])
    // Counting and listing a thread's replies.
    @@index([parentId])
  }
}

namespace channels {
  model BroadcastChannel {
    id          String   @id @default(uuid())
    authorId    String
    name        String

    /// Stable, URL-safe identity, derived once from the name -- the same rule
    /// `content.Story.slug` and `clubs.BookClub.slug` follow.
    slug        String   @unique

    description String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @default(now())

    author      auth.User
      @relation(fields: [authorId], references: [id])
    subscribers ChannelSubscriber[]
    posts       ChannelPost[]
  }

  model ChannelSubscriber {
    id           String   @id @default(uuid())
    channelId    String
    userId       String
    subscribedAt DateTime @default(now())

    channel BroadcastChannel
      @relation(fields: [channelId], references: [id])
    user auth.User
      @relation(fields: [userId], references: [id])

    @@unique([channelId, userId])
  }

  model ChannelPost {
    id        String   @id @default(uuid())

    channelId String

    /// The post's headline. A post has no author of its own: only the
    /// channel's owner may write one, so the author is the channel's.
    title     String

    content   String

    /// When a moderator hid this. The same column, meaning the same thing, as
    /// `engagement.Comment.hiddenAt` and `clubs.ClubDiscussion.hiddenAt`.
    hiddenAt  DateTime?

    postedAt  DateTime @default(now())
    updatedAt DateTime @default(now())

    channel BroadcastChannel
      @relation(fields: [channelId], references: [id])

    // The channel feed: one channel's posts, newest first.
    @@index([channelId, postedAt])
  }
}

namespace library {
  // A book a reader has put on one of their shelves.
  //
  // Distinct from engagement.ReadingHistory, which tracks *where* someone is
  // inside a story. This records only the intent -- want to read, reading,
  // finished -- so a book can sit on a shelf with no reading progress at all.
  model LibraryEntry {
    id      String        @id @default(uuid())
    userId  String
    storyId String
    status  ReadingStatus @default(WANT_TO_READ)

    addedAt   DateTime @default(now())
    updatedAt DateTime @default(now())

    user auth.User
      @relation(fields: [userId], references: [id], onDelete: Cascade)
    story content.Story
      @relation(fields: [storyId], references: [id], onDelete: Cascade)

    // One shelf slot per reader per book.
    @@unique([userId, storyId])
    // The shelf tabs read by user, filtered by status, newest first.
    @@index([userId, status, addedAt])
    @@index([storyId])
  }
}

namespace notifications {
  /// One thing that happened, addressed to one person.
  ///
  /// Three decisions are written into these columns.
  ///
  /// **The actor is a foreign key; the subject is a copy.** `actorId` joins to
  /// `auth.User` on every read, so a renamed handle or a changed avatar is
  /// current wherever it appears. `title`, `excerpt` and `href` are captured
  /// at fan-out time and never refreshed, because the alternative is five
  /// different joins for five types and a list that breaks the day somebody
  /// deletes a story. A notification is a record of a moment; reading the
  /// moment's wording back as it was is right, and reading a stale name for
  /// the person is not.
  ///
  /// **`href` is a path, not an id.** What a notification links to is a
  /// decision about the web app's routes, and the route is already known at
  /// the point the row is written. Storing the pieces instead would put a
  /// second copy of the routing table in the client.
  ///
  /// **There is no payload blob.** Every type renders the same three fields,
  /// which is what makes one dropdown able to draw all five. A `jsonb` column
  /// would let a type carry something extra and nothing would render it.
  model Notification {
    id      String           @id @default(uuid())

    /// Who this is for. Every query starts here.
    userId  String

    type    NotificationType

    /// Who did it, or null for `BADGE_EARNED` -- the one type nobody else
    /// caused. Never the recipient: the fan-out excludes the actor in the
    /// same statement that selects the audience, so no row here says somebody
    /// did something to themselves.
    actorId String?

    /// What it happened to: the channel's name, the club's name, the story's
    /// title, the badge's name.
    title   String

    /// A line of the thing itself -- the post's title, the reply's body -- cut
    /// to `EXCERPT_LENGTH` in `services/notifications.ts`. Null where the type
    /// has no body to quote.
    excerpt String?

    /// Where clicking it goes, as a web-app path.
    href    String

    /// The row `excerpt` was copied from, when that row is one a moderator
    /// can hide -- null for `NEW_STORY` and `BADGE_EARNED`, which quote
    /// nothing hideable.
    ///
    /// The excerpt is a *copy*, so hiding the comment it came from does not
    /// hide it; without these two columns there would be no way to find the
    /// copies at all. `hideContent` in `services/moderation.ts` deletes the
    /// rows they match, and that file says why deleting rather than blanking.
    /// Null on every row written before moderation landed, which is honest:
    /// those copies cannot be found and are left alone.
    sourceType ReportTarget?
    sourceId   String?

    /// Null until read. Null *is* the unread flag rather than a boolean
    /// beside a timestamp, which would be two answers to one question.
    readAt    DateTime?

    createdAt DateTime  @default(now())

    user  auth.User
      @relation("NotificationRecipient", fields: [userId], references: [id])
    actor auth.User?
      @relation("NotificationActor", fields: [actorId], references: [id])

    /// The list: one person's notifications, newest first.
    @@index([userId, createdAt])
    /// The unread count, and the mark-all-read sweep.
    @@index([userId, readAt])
    /// The sweep when a moderator hides the thing a notification quoted.
    @@index([sourceType, sourceId])
  }
}

namespace moderation {
  /// One reader saying one thing should not be there.
  ///
  /// **The target is polymorphic and therefore not a foreign key.**
  /// `targetType` plus `targetId` names a row in one of three tables, and no
  /// constraint can express that. The cost is real and bounded: deleting a
  /// comment leaves a report pointing at nothing, so `listReports` hydrates
  /// targets tolerantly and renders a missing one as gone. The alternative --
  /// three nullable columns with three foreign keys, exactly one of them set
  /// -- moves the same "exactly one" rule from the service into a CHECK
  /// nothing else could read, and triples again the day a fourth surface
  /// wants reporting.
  ///
  /// **One open report per reporter per target, enforced in the service.**
  /// A unique index cannot say "only while open", because a target resolved
  /// today may legitimately be reported again tomorrow. `createReport` writes
  /// through an `INSERT ... WHERE NOT EXISTS`; see that function for the race
  /// that leaves and why resolving sweeps every open report on the target.
  ///
  /// **`status` and `action` are two questions.** Whether anybody still has
  /// to look at this, and what was done. Folding them into one column would
  /// make "show me the queue" enumerate the resolutions.
  ///
  /// **A null `reporterId` is the automated check, not a missing person.** The
  /// classifier in `services/ai/moderation.ts` files its findings here so they
  /// reach the same queue, the same actions and the same undo as a reader's
  /// report. A service account was the alternative and was not taken: it would
  /// be a row in `auth.User` that every follower count, author list, admin
  /// check and account deletion then has to remember is not a person. Null
  /// says what is true -- nobody reported this -- and the one place that has to
  /// handle it is the queue.
  model Report {
    id         String       @id @default(uuid())
    reporterId String?
    targetType ReportTarget
    targetId   String
    reason     ReportReason

    /// What the reporter typed, cut to `DETAILS_MAX_LENGTH` in the service.
    /// Null when they only picked a reason.
    details    String?

    status     ReportStatus @default(OPEN)

    /// Null while open.
    action     ReportAction?
    /// What the moderator wrote when resolving. Never shown to the reporter.
    note       String?
    resolvedById String?
    resolvedAt   DateTime?

    createdAt  DateTime @default(now())
    updatedAt  DateTime @default(now())

    reporter   auth.User? @relation("ReportReporter", fields: [reporterId], references: [id])
    resolvedBy auth.User? @relation("ReportResolver", fields: [resolvedById], references: [id])

    /// The queue: open first, newest first.
    @@index([status, createdAt])
    /// Duplicate detection, and resolving every open report on one target.
    @@index([targetType, targetId, status])
    /// A reporter's own history, which is what a moderator checks before
    /// trusting the tenth report from the same account in an hour.
    @@index([reporterId])
  }
}

/// Generated artefacts, kept apart from the content they describe.
///
/// Its own namespace for the reason every other one here has its own: a
/// summary is not a property of a chapter, it is a derived thing with its own
/// lifecycle, its own staleness and its own reasons to be thrown away. Folding
/// it onto `content.Chapter` would put a model's output in the same row as the
/// author's words, and the first time a regeneration went wrong that would be
/// a chapter edit rather than a cache miss.
namespace ai {
  /// A short "previously in this story" recap of one chapter.
  ///
  /// **`contentHash` is the whole design.** Generating one of these costs tens
  /// of seconds on a local model, and the text it describes usually has not
  /// changed since the last time somebody asked. So the hash of the chapter
  /// body that produced this row is stored beside it, and a request whose
  /// chapter still hashes to the same value is answered from here without a
  /// model call. An author's edit changes the hash, which is what makes the
  /// stale recap regenerate itself rather than having to be invalidated by
  /// whatever code did the editing.
  ///
  /// **One row per chapter**, hence the unique index rather than a history.
  /// Keeping every recap a chapter ever had would be a table that grows with
  /// edits and is read for exactly one row, and the superseded text has no
  /// reader: nobody wants last week's summary of a paragraph that changed.
  ///
  /// `model` and `promptVersion` are recorded because a recap that reads badly
  /// is evidence about a prompt or a model, and neither is answerable months
  /// later from the text alone. They are also what a future regeneration sweep
  /// would select on -- "every recap written by the prompt we just fixed".
  model ChapterSummary {
    id            String   @id @default(uuid())
    chapterId     String   @unique
    /// The recap itself. Always labelled as generated where it is shown.
    text          String
    /// SHA-256 of the chapter body this was written from; see above.
    contentHash   String
    /// The model that wrote it, as the provider named it.
    model         String
    /// `RECAP_PROMPT_VERSION` at the time of writing.
    promptVersion Int
    /// Which prompt wrote it; with `promptVersion`, resolvable through
    /// `prompts/registry.ts`.
    promptId      String   @default("recap")
    createdAt     DateTime @default(now())
    updatedAt     DateTime @default(now())

    chapter content.Chapter @relation(fields: [chapterId], references: [id])
  }

  /// One embedded passage of one chapter: the unit retrieval actually returns.
  ///
  /// **The vector is not declared here, and cannot be.** The column is
  /// `vector(768)`, a type contributed by the `pgvector` extension, and the
  /// Prisma Next extension package that would let a contract name it
  /// (`pgvector.Vector(length: 768)`) is not published for this release. So
  /// the migration adds the `embedding` column itself with `typeSql`, and
  /// every read and write of it goes through the raw-SQL lane in
  /// `services/ai/embeddings.ts`. Everything a query *filters* on is declared
  /// below and typed; only the vector is untyped, and it is never filtered on
  /// -- it is measured against. Swap this for a declared column the day the
  /// extension package exists; nothing above the service changes.
  ///
  /// `db verify --strict` will report the extra column, because the contract
  /// does not know about it. Plain `db verify` will not: extras in the
  /// database are allowed by default.
  ///
  /// **`contentHash` is what stops the corpus being embedded twice.** It is
  /// the SHA-256 of `text` -- this chunk's own prose, not the whole chapter --
  /// so an author fixing a typo in one paragraph re-embeds the one or two
  /// windows that paragraph falls in and reuses the rest. Embedding is the
  /// most duplicated cost in the AI backlog, and this column is the whole of
  /// the defence against it.
  ///
  /// `model` and `dimensions` sit on the row rather than in configuration
  /// because a corpus is embedded over time and a model can change under it.
  /// Vectors from two models are not comparable, so the row has to say which
  /// one wrote it -- and that is also what lets a re-embedding sweep select
  /// exactly the rows a model change invalidated.
  ///
  /// `storyId` is denormalised from the chapter so that a search can filter by
  /// story without joining -- a vector scan that has to join to apply a filter
  /// is a vector scan that reads far more rows than it returns.
  ///
  /// Both foreign keys cascade, unlike `ChapterSummary` above, whose rows
  /// `services/authoring.ts` deletes by hand before the chapter goes. These
  /// are derived data with no independent worth, there are many per chapter,
  /// and a third place that has to remember they exist is a third place to
  /// forget.
  model ChapterChunk {
    id          String   @id @default(uuid())
    storyId     String
    chapterId   String
    /// Position within the chapter, from 0. Windows overlap; see `chunking.ts`.
    ordinal     Int
    /// The exact text that was embedded, and what a search result quotes.
    text        String
    /// SHA-256 of `text`; see above.
    contentHash String
    /// The embedding model, as the provider named it.
    model       String
    /// The width of `embedding`. Must match the column and the configuration.
    dimensions  Int
    createdAt   DateTime @default(now())

    story   content.Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)
    chapter content.Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

    /// One row per window per chapter: what makes a re-embed a replacement
    /// rather than an accumulation, and what a concurrent second backfill
    /// collides with instead of silently doubling the index.
    @@unique([chapterId, ordinal])
    /// Retrieval filters by story; the backfill and reuse path looks up by hash.
    @@index([storyId])
    @@index([chapterId, contentHash])
  }

  /// One reader's Ask This Book conversation about one story.
  ///
  /// **Private to its owner, and asserted on every read**: the service looks
  /// a conversation up by id *and* `userId` together, so somebody else's id
  /// resolves to nothing -- a 404, never a 403 that confirms it exists. It is
  /// also re-checked against the story's visibility, because a conversation
  /// quotes chapters, and a story its author has since unlisted should not
  /// keep being quoted through a side door.
  ///
  /// **`summary` and `summarizedThrough` are the rolling memory.** A long
  /// conversation is not replayed to the model turn by turn; once turns fall
  /// out of the recent window they are folded into `summary`, and
  /// `summarizedThrough` is the ordinal of the last message folded in. Both
  /// are model output and are treated as untrusted when they go back into a
  /// prompt. See `foldIntoSummary` in `services/ai/conversations.ts`.
  ///
  /// Every foreign key cascades, as `ChapterChunk`'s do: a conversation has
  /// no worth once its reader or its story is gone, and the reader's own
  /// questions are personal data that an account deletion has to take with
  /// it -- the cascade is what guarantees nobody has to remember to.
  model Conversation {
    id                String   @id @default(uuid())
    userId            String
    storyId           String
    /// The opening question, trimmed. A label for the history list.
    title             String
    /// Generated; empty until the conversation outgrows its recent window.
    summary           String   @default("")
    /// Ordinal of the last message folded into `summary`; 0 for none.
    summarizedThrough Int      @default(0)
    /// The prompt that last wrote `summary`; null until there is one.
    summaryPromptId      String?
    summaryPromptVersion Int?
    createdAt         DateTime @default(now())
    updatedAt         DateTime @default(now())

    user     auth.User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    story    content.Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
    messages ConversationMessage[]

    /// The history list: one reader's conversations about one story.
    @@index([userId, storyId])
  }

  /// One turn: a reader's question or the answer to it.
  ///
  /// `ordinal` orders the conversation and is unique within it, which is what
  /// makes "append the next turn" safe against a double-submitted question --
  /// the second insert collides rather than interleaving.
  ///
  /// A question records the **standalone** form it was rewritten to as well as
  /// what the reader typed: "what happened after that?" is what they asked,
  /// the rewritten question is what was embedded and retrieved with, and when
  /// an answer is wrong the rewrite is the first thing to look at.
  model ConversationMessage {
    id                 String   @id @default(uuid())
    conversationId     String
    ordinal            Int
    /// `user` or `assistant`.
    role               String
    content            String
    /// User turns: the question rewritten to stand alone. Null on the first
    /// turn, which needs no rewriting.
    standaloneQuestion String?
    /// Assistant turns: the spoiler bound the answer was drawn under, and the
    /// rule that chose it (`AskScopeBasis`). Null `upToChapter` is the whole story.
    upToChapter        Int?
    scopeBasis         String?
    /// Assistant turns: false when nothing in range covered the question and
    /// the answer is the app's fixed decline rather than a model's.
    answerable         Boolean  @default(true)
    /// Assistant turns a model wrote: the prompt that wrote the answer. Null
    /// for the reader's own turns, for the fixed decline, and for answers
    /// stored before prompts were recorded.
    promptId           String?
    promptVersion      Int?
    /// Every model call this turn cost -- rewrite, summary and answer.
    inputTokens        Int      @default(0)
    outputTokens       Int      @default(0)
    createdAt          DateTime @default(now())

    conversation Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    citations    ConversationCitation[]

    @@unique([conversationId, ordinal])
  }

  /// One passage an answer cited, kept so the conversation can be reopened
  /// with its citations intact.
  ///
  /// **Not a chunk id.** The backfill replaces a chapter's chunk rows when it
  /// re-embeds them, so a chunk id goes stale on the next edit. What is kept
  /// is the chapter, the window's position in it, and the quote exactly as
  /// the reader was shown it -- which is what reopening needs, and what stays
  /// true after an edit. Deleting the chapter deletes the citation; the answer
  /// keeps its text and loses the link, which the client already handles for
  /// a marker that points at nothing.
  model ConversationCitation {
    id        String @id @default(uuid())
    messageId String
    /// The `[n]` the answer used for it.
    marker    Int
    chapterId String
    /// The window's ordinal within the chapter; see `ChapterChunk.ordinal`.
    ordinal   Int
    quote     String

    message ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
    chapter content.Chapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)

    @@unique([messageId, marker])
    @@index([chapterId])
  }

  /// One fact of an author's story bible: a character's attribute, a place, a
  /// relationship or an event, with the chapter that says so.
  ///
  /// **Two origins, one table.** `extracted` rows are a model's reading of a
  /// chapter and are replaced wholesale whenever that chapter's text changes.
  /// `author` rows are the author's own -- a correction of an extracted fact
  /// (converted in place, keeping its evidence) or a fact they added -- and
  /// re-extraction never touches them. Within one chapter, an author row wins
  /// over any extracted fact with the same `factKey`; that precedence is the
  /// whole of "a corrected fact survives re-extraction", and it lives in
  /// `services/ai/story-bible.ts`.
  ///
  /// **A rejected fact is kept, not deleted**, because deleting it would let
  /// the next extraction of the same unchanged sentence put it straight back.
  /// `rejected` rows are never shown and never sent to a model; they exist
  /// only to suppress a re-extraction of the same claim (`factKey` plus
  /// `valueKey`) in the same chapter.
  ///
  /// `quote` is the evidence, and for an extracted fact it has been checked to
  /// occur in the chapter text -- a fact whose quote the chapter does not
  /// contain is dropped at extraction rather than stored on a model's word.
  ///
  /// The `embedding` column is `vector(768)` and, like `ChapterChunk`'s, is
  /// added by the migration and read through the raw-SQL lane: the contract
  /// cannot declare it. `embedModel` says which model wrote it, null when the
  /// fact has not been embedded (an embedder outage at extraction time).
  ///
  /// Every foreign key cascades: a bible is derived from, and private to, the
  /// story it describes.
  model StoryFact {
    id            String   @id @default(uuid())
    storyId       String
    /// The evidence chapter. Null only for a fact the author added for the
    /// whole story rather than for one chapter.
    chapterId     String?
    /// `character`, `location`, `relationship` or `event`.
    kind          String
    subject       String
    attribute     String
    value         String
    /// For a relationship, the other party; null otherwise.
    related       String?
    /// The chapter's own words for this fact. Null for an author's own fact.
    quote         String?
    /// Normalised kind, subject and attribute: the identity precedence uses.
    factKey       String
    /// Normalised value, so a rejection can recognise the same claim again.
    valueKey      String
    /// `extracted` or `author`.
    origin        String
    rejected      Boolean  @default(false)
    /// The chat model and prompt version that extracted it; null for `author`.
    model         String?
    promptVersion Int?
    /// The model that wrote the raw `embedding` column, or null.
    embedModel    String?
    createdAt     DateTime @default(now())
    updatedAt     DateTime @default(now())

    story   content.Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
    chapter content.Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

    @@index([storyId])
    @@index([chapterId])
  }

  /// The record that one chapter's facts were extracted, and from what text.
  ///
  /// `contentHash` does here what it does on `ChapterSummary`: a chapter
  /// whose text and prompt version are unchanged is not sent to a model again,
  /// whoever asks and however often. A story has a bible exactly when at least
  /// one of its chapters has a row here, which is also what switches the
  /// continuity checker on for it.
  model ChapterExtraction {
    id            String   @id @default(uuid())
    chapterId     String   @unique
    storyId       String
    contentHash   String
    model         String
    promptVersion Int
    /// See `ChapterSummary.promptId`.
    promptId      String   @default("story-bible.extract")
    /// Facts kept, after grounding and author precedence.
    factCount     Int      @default(0)
    /// Facts the model offered whose quote the chapter does not contain.
    droppedCount  Int      @default(0)
    /// True when the chapter was longer than the extraction reads, and its
    /// end contributed no facts. Said rather than hidden.
    truncated     Boolean  @default(false)
    createdAt     DateTime @default(now())
    updatedAt     DateTime @default(now())

    story   content.Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)
    chapter content.Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

    @@index([storyId])
  }

  /// The last continuity check of one chapter.
  ///
  /// `contentHash` is the text that was checked: a save that changes nothing
  /// does not check again, and a page can tell an author their findings
  /// describe an older draft. `contextHash` is what it was checked *against*
  /// -- the chapter's claims and the established facts chosen for them -- so
  /// a fix to chapter two makes chapter five's findings stale even though
  /// chapter five's text never moved. A `failed` outcome stores no findings
  /// and is retried on the next save: a check that could not run is not a
  /// clean bill of health.
  model ContinuityCheck {
    id            String   @id @default(uuid())
    chapterId     String   @unique
    storyId       String
    contentHash   String
    contextHash   String   @default("")
    /// `ok` or `failed`.
    outcome       String
    /// Established facts the chapter's own facts were compared against.
    comparedCount Int      @default(0)
    model         String?
    promptVersion Int
    /// See `ChapterSummary.promptId`.
    promptId      String   @default("continuity")
    createdAt     DateTime @default(now())
    updatedAt     DateTime @default(now())

    story   content.Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)
    chapter content.Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

    @@index([storyId])
  }

  /// One possible contradiction between a chapter and the rest of its story.
  ///
  /// **Both pieces of evidence are copied onto the row** -- the claim from the
  /// checked chapter and the fact it contradicts -- rather than pointing at
  /// `StoryFact` rows, which are replaced whenever either chapter is
  /// re-extracted. A finding has to stay readable exactly as it was raised.
  ///
  /// `fingerprint` identifies the *pair of claims*, not the row: a hash of
  /// both facts' chapter, key and value, so the same contradiction found on
  /// a later check has the same fingerprint, and a dismissal of it holds.
  model ContinuityFinding {
    id             String   @id @default(uuid())
    storyId        String
    /// The chapter that was checked: where the claim is.
    chapterId      String
    /// Where the contradicted fact is; null for a story-wide author fact.
    otherChapterId String?
    fingerprint    String
    /// `attribute`, `whereabouts`, `timeline`, `death`, `relationship` or `other`.
    kind           String
    /// Generated: one sentence saying what does not add up.
    explanation    String
    /// 0-100, as the model reported it. Below the configured floor is never stored.
    confidence     Int
    claimSubject   String
    claimAttribute String
    claimValue     String
    claimQuote     String
    factSubject    String
    factAttribute  String
    factValue      String
    factQuote      String?
    /// `extracted` or `author`: whether the contradicted fact is one the author confirmed.
    factOrigin     String
    createdAt      DateTime @default(now())

    story        content.Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
    chapter      content.Chapter  @relation("ContinuityFindingChapter", fields: [chapterId], references: [id], onDelete: Cascade)
    otherChapter content.Chapter? @relation("ContinuityFindingEvidence", fields: [otherChapterId], references: [id], onDelete: Cascade)

    @@unique([chapterId, fingerprint])
    @@index([storyId])
  }

  /// A contradiction the author has said is not one. Never raised again.
  ///
  /// Keyed by the finding's `fingerprint`, per story, so it outlives the
  /// finding row it was made from: the next check of an edited chapter that
  /// finds the same pair of claims recognises it and stays silent.
  model ContinuityDismissal {
    id          String   @id @default(uuid())
    storyId     String
    fingerprint String
    createdAt   DateTime @default(now())

    story content.Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

    @@unique([storyId, fingerprint])
  }

  /// One run of the automated content check over one piece of member text.
  ///
  /// **Why this is not `moderation.Report`.** A finding that needs a person
  /// *is* filed there, and `reportId` points at it. But most runs conclude
  /// nothing is wrong, and a report is somebody asking for a look -- a row per
  /// clean comment would bury the queue it exists to feed. And a report has
  /// nowhere to put what makes a machine's call explainable: which model, which
  /// prompt, how sure it was of each category. So the queue is reused for what
  /// it is, and this is the record behind it.
  ///
  /// **Append-only.** A re-run adds a row rather than replacing one, because
  /// the question this table answers months later is "why was this hidden?",
  /// and an overwrite would answer it with whatever the latest prompt thinks.
  ///
  /// **No copy of the text, and no foreign key.** The target is polymorphic for
  /// the reason `moderation.Report`'s is. `contentHash` says what was read
  /// without keeping it, which is also what lets an unchanged row be skipped
  /// and lets these rows outlive a deleted comment or account holding nothing
  /// that was theirs.
  model ModerationDecision {
    id            String            @id @default(uuid())
    targetType    ReportTarget
    targetId      String
    outcome       ModerationOutcome
    /// The category that decided the outcome; null for `ALLOW` and `UNCHECKED`.
    category      String?
    /// SHA-256 of the text that was classified.
    contentHash   String
    /// The model that judged it, as the provider named it. Empty for
    /// `UNCHECKED`, when no model answered.
    model         String
    /// `MODERATION_PROMPT_VERSION` at the time.
    promptVersion Int
    /// See `ChapterSummary.promptId`.
    promptId      String            @default("moderation")
    /// The thresholds in force, so a decision can be re-read against the
    /// numbers that made it rather than today's configuration.
    reviewThreshold Decimal
    rejectThreshold Decimal
    /// Why there is no verdict, for `UNCHECKED`: a short fixed word, never a
    /// provider's message.
    failure       String?
    /// The report this run filed, when it filed one.
    reportId      String?
    createdAt     DateTime @default(now())

    scores ModerationScore[]

    /// The latest decision for a target, and its history.
    @@index([targetType, targetId, createdAt])
    /// What has not been looked at, for the backfill.
    @@index([outcome, createdAt])
    @@index([reportId])
  }

  /// How sure one run was about one category.
  ///
  /// A table rather than a column of JSON so that "every decision where
  /// harassment scored above 0.8" is a query -- which is the question asked
  /// whenever a threshold is being moved.
  model ModerationScore {
    decisionId String
    /// One of `MODERATION_CATEGORIES`' ids in `services/ai/moderation.ts`.
    category   String
    /// 0 to 1.
    confidence Decimal

    decision ModerationDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

    @@id([decisionId, category])
  }
}
