# Copy this file to `.env` and replace the placeholders with real values.

# Port the Vite dev server listens on.
VITE_PORT=1302

# Where the dev server proxies /api. Running the app on the host, this is the
# API's published port; under docker-compose.yml, Compose overrides it with
# http://api:1303.
VITE_API_PROXY_TARGET=http://localhost:1303

# Google sign-in: the OAuth 2.0 *Web application* client id from Google Cloud
# (APIs & Services > Credentials). Add http://localhost:1302 to Authorised
# JavaScript origins. Left blank, the Google button reports that sign-in is
# not configured rather than failing obscurely.
VITE_GOOGLE_CLIENT_ID=
